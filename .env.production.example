# ============================================================
# Agent Eval Workbench — 生产环境配置
# 复制为 .env.production 并填写真实值，然后:
#   docker compose --env-file .env.production up -d --build
# ============================================================

APP_ENV=production

# --- 数据库 / Redis（生产请改为强密码，且不要暴露到公网）---
DATABASE_URL=postgresql+psycopg://agent_eval:CHANGE_ME_DB_PASSWORD@postgres:5432/agent_eval
REDIS_URL=redis://redis:6379/0

# --- 关键密钥（务必替换为强随机值，可用 `openssl rand -hex 32` 生成）---
API_KEY_SALT=CHANGE_ME_API_KEY_SALT
WORKSPACE_SESSION_SECRET=CHANGE_ME_WORKSPACE_SESSION_SECRET
JWT_SECRET=CHANGE_ME_JWT_SECRET

# --- 登录态有效期（分钟，默认 7 天 = 10080）---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 首次启动的管理员账号（用于创建其他成员账号）---
AGENT_EVAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGENT_EVAL_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- 凭据加密密钥（32 字节 base64，用 `openssl rand -base64 32` 生成）---
AGENT_EVAL_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_CREDENTIAL_ENCRYPTION_KEY
AGENT_EVAL_CREDENTIAL_ENCRYPTION_KEY_ID=primary

# --- 前端构建参数（同源反代后 API 走 /api 或同端口时留空由 NEXT_PUBLIC_API_URL 指定）---
# 若前端通过 Nginx 反代到同域名，建议 NEXT_PUBLIC_API_URL 设为 https://你的域名
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PROJECT_ID=default-project

# --- 端口（生产建议只暴露 Web，API 由反代转发）---
AGENT_EVAL_WEB_PORT=3000
AGENT_EVAL_API_PORT=8000

# --- PostgreSQL 密码（与 DATABASE_URL 中保持一致）---
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- 构建镜像源（国内服务器可选，用于加速 pip/npm 下载；海外留空即用官方源）---
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

# --- 生产前端 CORS 白名单（逗号分隔，追加到内置 localhost 开发白名单之后）---
# 前端域名与 API 域名不同源时必须配置，否则浏览器会拦截跨域请求。
AGENT_EVAL_CORS_ORIGINS=https://www.example.com,https://example.com
