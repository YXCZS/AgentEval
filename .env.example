APP_ENV=development
DATABASE_URL=postgresql+psycopg://agent_eval:agent_eval@postgres:5432/agent_eval
REDIS_URL=redis://redis:6379/0
API_KEY_SALT=change-me-before-use
WORKSPACE_SESSION_SECRET=change-me-before-use
NEXT_PUBLIC_WORKSPACE_SESSION=dev:default-project:change-me-before-use
AGENT_EVAL_WEB_PORT=3000
AGENT_EVAL_API_PORT=8000
# Base64-encoded 32-byte AES key. Generate locally; never reuse a model API key.
AGENT_EVAL_CREDENTIAL_ENCRYPTION_KEY=
AGENT_EVAL_CREDENTIAL_ENCRYPTION_KEY_ID=primary
# JSON map from Evaluator Connection auth_ref to an HMAC signing secret.
# Keep real values only in the ignored .env file.
AGENT_EVAL_EXTERNAL_EVALUATOR_SECRETS={}
TRACE_MAX_FIELD_BYTES=16384
TRACE_REDACTION_FIELD_NAMES=["api_key","authorization","token","secret","password","credential","cookie","access_key"]

# Python SDK connection. Create a Project API Key in the workbench; never commit it.
AGENT_EVAL_BASE_URL=http://127.0.0.1:8000
AGENT_EVAL_PROJECT_ID=default-project
AGENT_EVAL_API_KEY=

# Explicit live acceptance only. Keep real values in the ignored .env file.
LIVE_ACCEPTANCE_BASE_URL=https://api.deepseek.com/v1
LIVE_ACCEPTANCE_API_KEY=
LIVE_ACCEPTANCE_CHAT_MODEL=deepseek-chat
# Embeddings are a separate Provider because DeepSeek's chat endpoint does not provide them.
LIVE_ACCEPTANCE_EMBEDDING_BASE_URL=
LIVE_ACCEPTANCE_EMBEDDING_API_KEY=
LIVE_ACCEPTANCE_EMBEDDING_MODEL=
# The shorter EMBEDDING_* names are also accepted for a local live RAG run.
# LIVE_ACCEPTANCE_EMBEDDING_* takes precedence if both sets are configured.
# EMBEDDING_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v4
LIVE_ACCEPTANCE_TIMEOUT_SECONDS=30
